{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "m0-packaging-spike",
  "version": "0.0.0",
  "identifier": "dev.tauriplus.m0spike",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "M0 Packaging Spike",
        "width": 860,
        "height": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/python": "python/",
      "resources/site-packages": "site-packages/",
      "resources/backend": "backend/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {}
  }
}
