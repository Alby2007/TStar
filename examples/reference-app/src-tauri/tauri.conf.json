{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "reference-app",
  "version": "0.1.0",
  "identifier": "com.pylair.reference",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [{ "label": "main", "title": "reference-app", "width": 960, "height": 640 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/python": "python/",
      "resources/site-packages": "site-packages/",
      "resources/backend": "backend/"
    },
    "macOS": { "minimumSystemVersion": "12.0" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
