[package]
name = "__APP_NAME__"
version = "0.1.0"
edition = "2021"
rust-version = "1.85"
publish = false

[workspace]

[build-dependencies]
tauri-build = { version = "2", features = [] }

[lib]
name = "__APP_SNAKE___lib"
crate-type = ["staticlib", "cdylib", "rlib"]

[dependencies]
tauri = { version = "2", features = [] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
tokio = { version = "1", features = ["rt", "time", "sync", "process"] }
__PYLAIR_RS__

[features]
default = []
